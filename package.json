{
  "name": "@static-collective/static-field",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "npm run build:test && node --test \"build-test/tests/**/*.test.js\"",
    "build:test": "tsc -p tsconfig.json --outDir build-test",
