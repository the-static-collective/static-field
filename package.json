    "build": "tsc -p tsconfig.json",
    "start": "node build/src/server/app.js",
    "demo:first-bell": "node build/src/cli/first-bell.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
